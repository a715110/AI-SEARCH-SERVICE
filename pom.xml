      <version>${revision}</version>
    </dependency>
    <!-- STEP1: replaces com.azure:azure-storage-blob. This service has ecws-service (and through it common-service) on its classpath, so AzureBlobStorageHandler needs the auto-configured BlobServiceClient here too once AzureBlobConfig is deleted. -->
    <dependency>
      <groupId>com.azure.spring</groupId>
      <artifactId>spring-cloud-azure-starter-storage-blob</artifactId>
    </dependency>
    <!-- STEP1: Key Vault as a Spring PropertySource (version from the Azure BOM) -->
